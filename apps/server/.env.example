# Local server defaults. Render provides PORT automatically.
PORT=3001
HOST=0.0.0.0

# Public controller origin used when the server creates QR join URLs.
CONTROLLER_ORIGIN=http://127.0.0.1:5174

# Room/session tuning.
ROOM_TTL_MS=7200000
RECONNECT_GRACE_MS=30000
CLEANUP_INTERVAL_MS=15000
MESSAGE_COOLDOWN_MS=1200
MAX_MESSAGE_BYTES=4096

# Optional restart persistence.
# Use ROOM_STORE_FILE_PATH for local development only.
# Use ROOM_STORE_REDIS_URL for public deployments that should survive server restarts.
ROOM_STORE_FILE_PATH=.data/group-crash-rooms.json
# ROOM_STORE_REDIS_URL=redis://default:password@host:6379
ROOM_STORE_KEY_PREFIX=group-crash
