# Local server defaults. Render provides PORT automatically.
PORT=3001
HOST=0.0.0.0

# Public controller origin used when the server creates QR join URLs.
CONTROLLER_ORIGIN=http://127.0.0.1:5174

# Room/session tuning.
ROOM_TTL_MS=7200000
RECONNECT_GRACE_MS=30000
CLEANUP_INTERVAL_MS=15000
MESSAGE_COOLDOWN_MS=1200
MAX_MESSAGE_BYTES=4096
