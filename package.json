{
  "name": "group-crash",
  "version": "0.1.0",
  "private": true,
  "description": "Web-first second-screen multiplayer game platform for TV and phone controllers.",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev": "pnpm --filter @group-crash/tv dev",
    "dev:tv": "pnpm --filter @group-crash/tv dev",
    "dev:controller": "pnpm --filter @group-crash/controller dev",
    "dev:server": "pnpm --filter @group-crash/server dev",
    "test:integration": "pnpm --filter @group-crash/server test:integration"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
